{
  "name": "armoria-api",
  "version": "1.0.0",
  "description": "Heraldry generator API",
  "engines": {
    "node": ">=24"
  },
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --env-file-if-exists=.env --watch index.js",
    "test": "node --test --test-isolation=none test/*.test.js",
    "build:functions": "node scripts/build-functions.mjs",
    "discord:register": "node --env-file-if-exists=.env scripts/register-discord.mjs"
  },
  "keywords": [
    "heraldry",
    "API",
    "express"
  ],
  "author": "Azgaar (Max Haniyeu)",
  "license": "MIT",
  "dependencies": {
    "@resvg/resvg-js": "^2.4.1",
    "compression": "^1.7.4",
    "express": "^4.17.1",
    "minify-xml": "^2.5.0",
    "mongodb": "^3.6.4",
    "node-html-parser": "^2.1.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@netlify/zip-it-and-ship-it": "^16.5.1",
    "dotenv": "^8.2.0",
    "node-dev": "^6.2.0"
  }
}
