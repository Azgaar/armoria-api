# Runtime: public key from Discord Developer Portal > General Information.
DISCORD_PUBLIC_KEY=
# Runtime: canonical Netlify URL, including /api. No Vercel dependency.
ARMORIA_API_URL=https://YOUR-SITE.netlify.app/api

# Local command registration only; do not add the bot token to Netlify.
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
# Optional: restrict registration to a test server; omit for a global command.
DISCORD_GUILD_ID=

# Optional: existing claims database. Leave unset for procedural images only.
MONGODB_URI=
